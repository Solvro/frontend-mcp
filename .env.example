# Adresy serwisów backend-mcp widziane z serwera Next (BFF w app/bff).
# Domyślne porty z backend-mcp/docker/compose.yml (`just up`).
CHAT_SERVICE_URL=http://localhost:8001
AUTH_SERVICE_URL=http://localhost:8000

# Limity w backendzie liczą się per IP klienta. BFF wysyła je w X-Forwarded-For (ostatni
# wpis od proxy przed Next), a serwisy ufają temu nagłówkowi tylko od adresów z ich
# FORWARDED_ALLOW_IPS — adres serwera Next musi tam być, inaczej wszyscy anonimowi
# dzielą jeden limit (IP serwera Next).
